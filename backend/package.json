{
  "name": "freelahub-backend",
  "version": "0.1.0",
  "private": true,
  "description": "API do FreelaHub em Arquitetura Hexagonal",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "migrate": "tsx src/adapters/out/persistence/migrations/cli.ts",
    "migrate:down": "tsx src/adapters/out/persistence/migrations/cli.ts down",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude \"tests/integration/**\"",
    "test:integration": "vitest run tests/integration --no-file-parallelism"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
