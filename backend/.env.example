# Copie para backend/.env e troque os valores antes de subir o ambiente.
POSTGRES_USER=freelahub
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=freelahub

# Mínimo de 32 caracteres. Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=troque-por-um-segredo-aleatorio-de-32-caracteres
JWT_EXPIRES_IN_SECONDS=3600

# Administrador criado na carga inicial (RF01).
ADMIN_EMAIL=admin@freelahub.local
ADMIN_SENHA=troque-esta-senha-admin

# Execução da API fora do Docker.
PORT=3000
DATABASE_URL=postgres://freelahub:troque-esta-senha@localhost:5432/freelahub
